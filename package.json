{
  "name": "@jpahd/chatworks",
  "version": "0.3.0",
  "description": "Composable Lit web components and an extension-ready workbench runtime for AI-assisted chat, code, and arbitrary productivity workflows.",
  "license": "MIT",
  "author": "Paul Derscheid",
  "type": "module",
  "sideEffects": [
    "./src/components/*.ts",
    "./src/components/**/*.ts",
    "./src/index.ts",
    "./dist/components/*.js",
    "./dist/components/**/*.js",
    "./dist/index.js",
    "./dist/lib/events.js"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat-view": {
      "types": "./dist/components/chat-view.d.ts",
      "import": "./dist/components/chat-view.js"
    },
    "./composer": {
      "types": "./dist/components/chat-view/composer.d.ts",
      "import": "./dist/components/chat-view/composer.js"
    },
    "./attachment": {
      "types": "./dist/components/attachment.d.ts",
      "import": "./dist/components/attachment.js"
    },
    "./tool-event": {
      "types": "./dist/components/tool-event.d.ts",
      "import": "./dist/components/tool-event.js"
    },
    "./thinking-disclosure": {
      "types": "./dist/components/thinking-disclosure.d.ts",
      "import": "./dist/components/thinking-disclosure.js"
    },
    "./chat-turn": {
      "types": "./dist/components/chat-turn.d.ts",
      "import": "./dist/components/chat-turn.js"
    },
    "./message-list": {
      "types": "./dist/components/chat-view/message-list.d.ts",
      "import": "./dist/components/chat-view/message-list.js"
    },
    "./session-sidebar": {
      "types": "./dist/components/chat-view/session-sidebar.d.ts",
      "import": "./dist/components/chat-view/session-sidebar.js"
    },
    "./diff-view": {
      "types": "./dist/components/diff-view.d.ts",
      "import": "./dist/components/diff-view.js"
    },
    "./workbench": {
      "types": "./dist/lib/workbench.d.ts",
      "import": "./dist/lib/workbench.js"
    },
    "./workbench-view": {
      "types": "./dist/components/workbench-view.d.ts",
      "import": "./dist/components/workbench-view.js"
    },
    "./workbench-switcher": {
      "types": "./dist/components/workbench-switcher.d.ts",
      "import": "./dist/components/workbench-switcher.js"
    },
    "./command-palette": {
      "types": "./dist/components/command-palette.d.ts",
      "import": "./dist/components/command-palette.js"
    },
    "./diff": {
      "types": "./dist/lib/diff.d.ts",
      "import": "./dist/lib/diff.js"
    },
    "./settings-panel": {
      "types": "./dist/components/settings-panel.d.ts",
      "import": "./dist/components/settings-panel.js"
    },
    "./toast": {
      "types": "./dist/components/toast.d.ts",
      "import": "./dist/components/toast.js"
    },
    "./loading-indicator": {
      "types": "./dist/components/loading-indicator.d.ts",
      "import": "./dist/components/loading-indicator.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./chunk": {
      "types": "./dist/lib/chunk.d.ts",
      "import": "./dist/lib/chunk.js"
    },
    "./adapters/connect-rpc": {
      "types": "./dist/adapters/connect-rpc.d.ts",
      "import": "./dist/adapters/connect-rpc.js"
    },
    "./transport": {
      "types": "./dist/lib/transport.d.ts",
      "import": "./dist/lib/transport.js"
    },
    "./settings": {
      "types": "./dist/lib/settings.d.ts",
      "import": "./dist/lib/settings.js"
    },
    "./events": {
      "types": "./dist/lib/events.d.ts",
      "import": "./dist/lib/events.js"
    },
    "./focus": {
      "types": "./dist/lib/focus.d.ts",
      "import": "./dist/lib/focus.js"
    },
    "./catalog": {
      "types": "./dist/lib/catalog.d.ts",
      "import": "./dist/lib/catalog.js"
    },
    "./chat-types": {
      "types": "./dist/lib/chat-types.d.ts",
      "import": "./dist/lib/chat-types.js"
    },
    "./markdown": {
      "types": "./dist/lib/markdown.d.ts",
      "import": "./dist/lib/markdown.js"
    },
    "./highlight": {
      "types": "./dist/lib/highlight.d.ts",
      "import": "./dist/lib/highlight.js"
    },
    "./clipboard": {
      "types": "./dist/lib/clipboard.d.ts",
      "import": "./dist/lib/clipboard.js"
    },
    "./slash": {
      "types": "./dist/lib/slash.d.ts",
      "import": "./dist/lib/slash.js"
    },
    "./attachments": {
      "types": "./dist/lib/attachments.d.ts",
      "import": "./dist/lib/attachments.js"
    },
    "./proto/auth": {
      "types": "./dist/gen/gitchat/v1/auth_pb.d.ts",
      "import": "./dist/gen/gitchat/v1/auth_pb.js"
    },
    "./proto/chat": {
      "types": "./dist/gen/gitchat/v1/chat_pb.d.ts",
      "import": "./dist/gen/gitchat/v1/chat_pb.js"
    },
    "./proto/repo": {
      "types": "./dist/gen/gitchat/v1/repo_pb.d.ts",
      "import": "./dist/gen/gitchat/v1/repo_pb.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "test": "bun test src/",
    "test:storybook": "vitest run",
    "lint": "oxlint -c oxlintrc.json src/ stories/ .storybook/ vitest.config.ts",
    "fmt": "oxfmt --write src/ stories/ .storybook/ vitest.config.ts",
    "fmt:check": "oxfmt --check src/ stories/ .storybook/ vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@lit/context": "^1.1.3",
    "lit": "^3.2.1"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@happy-dom/global-registrator": "^20.9.0",
    "@lit/context": "^1.1.3",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/web-components-vite": "10.5.8",
    "@types/dompurify": "^3.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "bun-types": "^1.2.0",
    "lit": "^3.2.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "playwright": "1.62.1",
    "storybook": "10.5.8",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
